# No necesitas este archivo para empezar: `pnpm dev` crea .env.local con claves temporales.
# Úsalo si quieres usar tu propia app de Clerk: cópialo como .env.local y reemplaza las claves.
# Las encuentras en https://dashboard.clerk.com → tu app → API keys.
# Nunca subas .env.local a GitHub (ya está en .gitignore).

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REEMPLAZAR
CLERK_SECRET_KEY=sk_test_REEMPLAZAR

# Rutas de inicio de sesión y registro de esta plantilla (también están en app/layout.tsx)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Opcional: solo pueden confirmar asistencia las cuentas con un correo verificado de estos
# dominios (separados por comas; incluye subdominios). Vacío = evento abierto a todo el mundo.
# DOMINIOS_PERMITIDOS=miuniversidad.edu.bo,est.miuniversidad.edu.bo
